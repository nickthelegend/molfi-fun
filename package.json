{
  "name": "molfi",
  "private": true,
  "version": "2.0.0",
  "description": "Prediction markets where your position stays sealed until settlement, on Starknet through the STRK20 privacy pool",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "api:check": "node --experimental-strip-types scripts/api-check.mjs",
    "build": "pnpm --filter @molfi/web build",
    "build:all": "pnpm -r build",
    "deploy:devnet": "node --experimental-strip-types scripts/deploy.mjs --network devnet",
    "dev": "pnpm --filter @molfi/web dev",
    "dev:hub": "pnpm --filter @molfi/hub dev",
    "e2e:devnet": "node --experimental-strip-types scripts/e2e.mjs",
    "pool:probe": "node --experimental-strip-types scripts/pool-probe.mjs",
    "preflight": "node --experimental-strip-types scripts/preflight.mjs",
    "relay": "node --experimental-strip-types scripts/relay.mjs",
    "start": "pnpm --filter @molfi/web exec next start -p ${PORT:-3400}",
    "submission": "node --experimental-strip-types scripts/fill-submission.mjs",
    "test": "pnpm --filter @molfi/sdk test",
    "test:all": "bash scripts/test-all.sh",
    "test:cairo": "cd cairo && snforge test",
    "test:integration": "node --experimental-strip-types scripts/integration.mjs --network devnet",
    "typecheck": "pnpm --filter @molfi/sdk exec tsc --noEmit && pnpm --filter @molfi/web exec tsc --noEmit",
    "verify": "node --experimental-strip-types scripts/verify.mjs"
  },
  "pnpm": {
    "overrides": {
      "@swc/core": "1.13.5"
    }
  },
  "dependencies": {
    "starknet": "10.5.0"
  }
}
