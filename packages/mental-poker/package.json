{
  "name": "@mental-poker/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Mental Poker protocol on Starknet",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:crypto": "node --experimental-vm-modules node_modules/.bin/jest test/crypto.test.ts --forceExit",
    "e2e": "NODE_PATH=./node_modules npx tsx ../scripts/e2e-test.ts",
    "e2e:poker": "NODE_PATH=./node_modules npx tsx ../scripts/e2e-poker.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "=3.0.0-nightly.20251104",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@noir-lang/noir_js": "=1.0.0-beta.16",
    "garaga": "^1.0.1",
    "starknet": "^8.7.0"
  },
  "devDependencies": {
    "@noir-lang/types": "1.0.0-beta.16",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  }
}
