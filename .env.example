# Copy to .env and fill in. Never commit the real file.

# ── Starknet RPC ──────────────────────────────────────────────────────────────────
# Used by the deploy and end-to-end scripts. The console reads its own from
# apps/web/.env.local — see apps/web/.env.example.
#
# Create a free key at https://www.alchemy.com and enable the Starknet network you
# intend to use on it. A key scoped to an app without that network enabled answers
# every request with a 403, which is a confusing way to find out.
SEPOLIA_RPC=https://starknet-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Mainnet, CHAIN_ID SN_MAIN. Only set this when you actually intend to touch mainnet.
# MAINNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer ──────────────────────────────────────────────────────────────────────
# The sncast account that declares, deploys, and lists markets. Listing is owner-only,
# so this account owns the deployment.
#
# On devnet: `sncast account import --name devnet0 …` using a predeployed account.
DEPLOYER_ADDRESS=

# The address the local devnet uses in place of the privacy pool, so `privacy_invoke`
# can be driven directly. Never set on a public network — there the pool is the pool.
# DEVNET_ACCOUNT_ADDRESS=
