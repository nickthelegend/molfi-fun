// CrewKill keeper database.
//
// The chain is the source of truth for anything that decides money: stakes, ballots, roles
// and payouts all live in the CrewKill contract and are recomputed by `settle`. This
// database is the *index* over that chain state plus the off-chain clock Starknet does not
// have — phase deadlines, agent scheduling, and the narrative log the UI reads.
//
// Nothing here is authoritative. Live matches are re-read from the contract on every tick,
// so a stale row is corrected within seconds; a dropped database loses only the narrative
// log and the phase deadlines, not a single unit of anyone's stake.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A deployment of the CrewKill contract on one network. Rows are keyed by network so a
/// single keeper can index devnet and Sepolia side by side.
/// A deployment is a set of contract addresses on a chain, not just a chain.
///
/// This used to be keyed on `network` alone, so redeploying to a restarted devnet updated
/// the row in place and every match ever played was silently reattributed to contracts that
/// had never seen it. The archive then offered 600-odd matches whose settlement could not be
/// checked against anything, which on a project whose pitch is "verify it yourself" is the
/// worst possible kind of stale data.
model Deployment {
  id            Int      @id @default(autoincrement())
  network       String
  gameAddress   String
  ballotAddress String
  poolAddress   String
  stakeToken    String
  chainId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches Match[]
  txs     ChainTx[]

  @@unique([network, gameAddress])
}

model Match {
  id           Int        @id @default(autoincrement())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  deploymentId Int
  /// `match_id` in the contract.
  onchainId    BigInt

  phase        Int    @default(0)
  roundPhase   String?
  round        Int    @default(0)
  rounds       Int
  seatCount    Int
  seatsFilled  Int    @default(0)
  stakeAmount  String
  potAmount    String @default("0")
  impostorBps  Int
  detectiveBps Int
  protocolBps  Int

  seedCommitment String
  /// Held back until `start_match` lands on-chain. Storing it earlier would let a leak of
  /// this database reveal every role before the match begins.
  operatorSeed   String?
  finalSeed      String?

  crewWon              Boolean?
  impostorCount        Int?
  detectiveWeightTotal Int      @default(0)
  roundsPlayed         Int      @default(0)

  /// Live sabotage, if any, mirrored for the UI.
  sabotage       Int       @default(0)
  sabotageEndsAt DateTime?

  /// When the current off-chain phase expires. The keeper's only clock.
  phaseEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seats    Seat[]
  events   MatchEvent[]
  txs      ChainTx[]

  @@unique([deploymentId, onchainId])
  @@index([phase])
}

model Seat {
  id      Int   @id @default(autoincrement())
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId Int
  index   Int

  seatCommitment String
  persona        String
  emoji          String
  isAgent        Boolean @default(false)

  /// Only ever set for house agents. A human's secrets never reach this server — the
  /// browser keeps them and the keeper could not play their seat if it wanted to.
  agentRoleSecret  String?
  agentClaimSecret String?

  alive           Boolean @default(true)
  eliminatedRound Int?
  eliminatedBy    String?

  /// Live ship state, mirrored so the UI can draw the map and a restart keeps the picture.
  location        Int     @default(0)
  tasksCompleted  Int     @default(0)
  totalTasks      Int     @default(4)
  inVent          Boolean @default(false)
  onCameras       Boolean @default(false)

  revealed   Boolean @default(false)
  roleSecret String?
  isImpostor Boolean?
  payout     String?
  claimed    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, index])
  @@index([matchId, seatCommitment])
}

model MatchEvent {
  id        Int      @id @default(autoincrement())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   Int
  round     Int      @default(0)
  kind      String
  text      String
  seat      Int?
  target    Int?
  createdAt DateTime @default(now())

  @@index([matchId, id])
}

/// Every transaction the keeper sent or observed, so the demo can link straight to a real
/// hash on a real explorer rather than claim one.
model ChainTx {
  id           Int        @id @default(autoincrement())
  match        Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId      Int?
  /// Scoped to the deployment, not the network. A devnet that restarts begins its block
  /// numbering again and reissues the same transaction hashes, which against a network-wide
  /// unique key collided with every hash from the previous run and made recording a
  /// transaction fail permanently.
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  deploymentId Int
  network      String
  kind         String
  hash         String
  status       String     @default("pending")
  createdAt    DateTime   @default(now())

  @@unique([deploymentId, hash])
  @@index([matchId])
}
