# Which chain the console reads and quotes against.
MOLFI_NETWORK=mainnet

# A Starknet RPC endpoint. Server side only — this value never reaches the browser, which is
# why the price and market routes exist at all. Without it the console falls back to a public
# endpoint, which works but is rate limited and drops connections under load.
#
# Free key: https://www.alchemy.com  →  https://starknet-mainnet.g.alchemy.com/v2/<YOUR_KEY>
STARKNET_RPC_URL=
