# Which chain the console reads and quotes against.
MOLFI_NETWORK=mainnet
NEXT_PUBLIC_NETWORK=mainnet

# A Starknet RPC endpoint, server side only. It never reaches the browser — that is why the
# price, market and rpc routes exist at all. Without it the console falls back to a public
# endpoint, which works but is rate limited and drops connections under load.
#
# Free key: https://www.alchemy.com. Enable the Starknet network you intend to use on the
# app the key belongs to; a key scoped to an app without it answers every request with a 403.
STARKNET_RPC_URL=

# molfi's market contract, once deployed. Absent means the console runs the demo desk and
# says so, which is the honest state before a deploy rather than an error.
# NEXT_PUBLIC_MARKET=

# Local devnet only. On a public network the pool, token and oracle are protocol facts and
# come from the SDK; these exist so a local run can point at stand-ins.
# NEXT_PUBLIC_POOL=
# NEXT_PUBLIC_TOKEN=
# NEXT_PUBLIC_ORACLE=

# --- Account bootstrapping (server-side only; never NEXT_PUBLIC_) -------------------------
# A Privy wallet is a keypair with no account contract behind it, and a counterfactual account
# cannot pay for its own deployment out of an empty balance. This faucet goes first: it sends a
# new account enough STRK to deploy itself, take a position and claim it. Use a dedicated
# account, NOT the keeper — the keeper holds the bankroll that pays winners.
FAUCET_ADDRESS=
FAUCET_PUBLIC_KEY=
FAUCET_PRIVATE_KEY=

# The live keeper's health endpoint, so /keeper and /api/keeper show the real process.
KEEPER_URL=

# A development-only Starknet key so the desk can be driven without a login. Server-side: the
# signing route uses it and it never reaches the browser. Absent in production, where the
# branch that reads it is removed as dead code.
DEV_WALLET_ADDRESS=
DEV_WALLET_PUBLIC_KEY=
DEV_WALLET_PRIVATE_KEY=
# The public half is exposed so the gate can render the bypass. Set BYPASS=1 to skip the login
# while driving the desk from an automated check; left unset, development shows the real door.
NEXT_PUBLIC_DEV_WALLET_ADDRESS=
NEXT_PUBLIC_DEV_WALLET_PUBLIC_KEY=
NEXT_PUBLIC_DEV_WALLET_BYPASS=
