# Which chain the console reads and quotes against.
MOLFI_NETWORK=mainnet
NEXT_PUBLIC_NETWORK=mainnet

# A Starknet RPC endpoint, server side only. It never reaches the browser — that is why the
# price, market and rpc routes exist at all. Without it the console falls back to a public
# endpoint, which works but is rate limited and drops connections under load.
#
# Free key: https://www.alchemy.com. Enable the Starknet network you intend to use on the
# app the key belongs to; a key scoped to an app without it answers every request with a 403.
STARKNET_RPC_URL=

# molfi's market contract, once deployed. Absent means the console runs the demo desk and
# says so, which is the honest state before a deploy rather than an error.
# NEXT_PUBLIC_MARKET=

# Local devnet only. On a public network the pool, token and oracle are protocol facts and
# come from the SDK; these exist so a local run can point at stand-ins.
# NEXT_PUBLIC_POOL=
# NEXT_PUBLIC_TOKEN=
# NEXT_PUBLIC_ORACLE=
