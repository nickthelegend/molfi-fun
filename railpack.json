{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": [
        { "cmd": "corepack enable" },
        { "cmd": "pnpm install --frozen-lockfile" }
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [{ "cmd": "pnpm --filter @molfi/web build" }]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @molfi/web exec next start -p $PORT"
  }
}
